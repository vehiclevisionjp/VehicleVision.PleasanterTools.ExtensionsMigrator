{
  "name": "develop-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/develop"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "build-test",
            "integration_id": 15368
          },
          {
            "context": "instructions",
            "integration_id": 15368
          },
          {
            "context": "nuget-audit",
            "integration_id": 15368
          },
          {
            "context": "npm-audit",
            "integration_id": 15368
          },
          {
            "context": "wip-title",
            "integration_id": 15368
          },
          {
            "context": "cla",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
